   199	      const cap = BigInt(Math.round(Number(f.cap) * 100)) * 1000000n;
   200	      const h = await w.deployContract({ abi: ABI, bytecode: BYTECODE, args: [11035, 1035, 1105n, cap, BigInt(Math.round(Number(f.floor) * 1e8)), BigInt(Math.round(Number(f.band) * 100)), 100n, start, BigInt(f.days)], chain: w.chain, account: w.account! });
   201	      const r = await pub.waitForTransactionReceipt({ hash: h }); location.hash = '#/p/' + r.contractAddress; }
   202	    catch (e) { setOut(revertReason(e)); } setBusy(false); };
   203	  return <main className="cols create"><article className="doc">
   204	    <p className="ref">Draft agreement for HYPE on the HyperCore HYPE/USDC spot book</p>
   205	    <h1>Draft a lock agreement</h1>
   206	    <p className="lede">Once signed, these terms are fixed in the contract. Nobody can loosen them, the team included.</p>
   207	    <ol className="clauses form">
   208	      <li><h2>Maximum sale per day</h2><label>HYPE of filled size per 24 hours<input inputMode="decimal" value={f.cap} onChange={set('cap')} aria-invalid={!capOk} /></label>{!mid && !midErr && <p className="meta" role="status">Checking today's HYPE price for the 10 USDC minimum order.</p>}{midErr && <p className="bad">Could not fetch the HYPE price, so the 10 USDC minimum order was not checked. Reload to retry.</p>}{!midErr && mid > 0 && capOk && <p className="meta">Checked against today's price of about ${mid.toFixed(2)}. The contract reprices at every sale, so a large price drop can still push a day's sale under 10 USDC.</p>}{!capOk && <p className="bad">{minCap && Number(f.cap) < minCap ? `HyperCore rejects orders under 10 USDC. At today's price of about $${mid.toFixed(2)}, the daily maximum must be at least ${minCap} HYPE.` : 'Use a number above 0 with at most 2 decimals.'}</p>}</li>
   209	      <li><h2>Start</h2><label>Selling begins (leave blank to start now)<input type="datetime-local" value={f.start} onChange={set('start')} /></label></li>
   210	      <li><h2>Term</h2><label>Length in days<input inputMode="numeric" value={f.days} onChange={set('days')} aria-invalid={!daysOk} /></label>{!daysOk && <p className="bad">A whole number of days, 1 to 3650.</p>}</li>
   211	      <li><h2>Sale price</h2><label>Floor, USDC per HYPE<input inputMode="decimal" value={f.floor} onChange={set('floor')} aria-invalid={!floorOk} /></label>{!floorOk && <p className="bad">Above 0, at most 8 decimals.</p>}<label>Largest discount to the oracle, %<input inputMode="decimal" value={f.band} onChange={set('band')} aria-invalid={!bandOk} /></label>{!bandOk && <p className="bad">Above 0 and under 100, at most 2 decimals.</p>}</li>
   212	    </ol>
   213	    {out && <p className="bad">{out}</p>}
   214	  </article>
   215	  <aside className="rail" aria-label="Summary">
   216	    <h2 className="rail-h">You are agreeing to</h2>
   217	    <dl className="attrs"><div><dt>Max sale / day</dt><dd className="fig">{f.cap} HYPE</dd></div><div><dt>Floor</dt><dd className="fig">${f.floor}</dd></div><div><dt>Max discount</dt><dd className="fig">{f.band}%</dd></div><div><dt>Selling starts</dt><dd className="fig">{ts(startD)}</dd></div><div><dt>Withdrawal opens</dt><dd className="fig">{ts(endD)}</dd></div><div><dt>Term</dt><dd className="fig">{f.days} days</dd></div><div className="full"><dt>Cancelable</dt><dd>No. There is no cancel or early withdraw path.</dd></div></dl>
   218	    <Dialog open={open} onOpenChange={setOpen}>
   219	      <DialogTrigger asChild><button className="btn-primary wide" disabled={busy || !valid}>{busy ? 'Deploying' : 'Review and sign'}</button></DialogTrigger>
   220	      <DialogContent className="sign">
   221	        <DialogHeader><DialogTitle className="sign-t">Sign this agreement</DialogTitle><DialogDescription className="sign-d">These terms cannot be changed after deployment.</DialogDescription></DialogHeader>
   222	        <ol className="sign-l"><li>Sell at most <span className="fig">{f.cap} HYPE</span> per day.</li><li>Never below <span className="fig">${f.floor}</span>, and no more than <span className="fig">{f.band}%</span> under the oracle.</li><li>Selling starts <span className="fig">{ts(startD)}</span>. No cancellation, and no withdrawal until <span className="fig">{ts(endD)}</span>.</li></ol>
   223	        <DialogFooter><DialogClose asChild><button className="btn-text">Go back</button></DialogClose><button className="btn-primary" onClick={go}>Sign and deploy on testnet</button></DialogFooter>
   224	      </DialogContent>
   225	    </Dialog>
   226	    {!valid && priceReady && <p className="bad">Fix the highlighted terms before signing.</p>}{!priceReady && <p className="meta" role="status">Waiting for today's HYPE price before signing.</p>}<p className="meta">Next: deposit HYPE from your HyperCore spot balance on the agreement page.</p>
   227	  </aside></main>;
   228	}

