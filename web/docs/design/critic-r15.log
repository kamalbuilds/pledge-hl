    68	.err{color:var(--danger);font-size:14px;margin:4px 0 0}
    69	.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    70	.log{list-style:none;padding:0;margin:12px 0 0;display:grid;gap:6px}.log li{font:12px var(--font-mono);background:var(--surface-2);border-radius:8px;padding:8px 10px}
    71	.secnav{margin-top:16px;border-top:1px solid var(--line);padding-top:12px;display:grid;gap:8px}.secnav>div{display:flex;gap:8px;overflow-x:auto;scrollbar-width:none}.navpill{flex:none;height:36px;padding:0 14px;border-radius:var(--radius-pill);border:1px solid var(--line);background:var(--surface-2);font:600 14px var(--font-sans);color:var(--ink);cursor:pointer}.navpill:hover{border-color:var(--band)}
    72	.dtable td,.dtable th{white-space:nowrap}
    73	.fill-list{list-style:none;padding:0;margin:0;display:grid;gap:8px}.fill-list li{background:var(--surface-2);border-radius:12px;padding:12px;display:grid;gap:4px}
