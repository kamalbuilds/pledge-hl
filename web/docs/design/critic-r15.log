   193	function Create() {
   194	  const [f, setF] = useState({ cap: '0.5', floor: '5', start: '', days: '30', band: '2' }); const [out, setOut] = useState(''); const [busy, setBusy] = useState(false); const [open, setOpen] = useState(false);
   195	  const set = (k: string) => (e: any) => setF({ ...f, [k]: e.target.value }); const capOk = /^\d+(\.\d{1,2})?$/.test(f.cap) && Number(f.cap) > 0 && Number(f.cap) <= 1e6, floorOk = /^\d+(\.\d{1,8})?$/.test(f.floor) && Number(f.floor) > 0 && Number(f.floor) <= 1e9, bandOk = /^\d+(\.\d{1,2})?$/.test(f.band) && Number(f.band) > 0 && Number(f.band) < 100, daysOk = /^\d+$/.test(f.days) && Number(f.days) >= 1 && Number(f.days) <= 3650, valid = capOk && floorOk && bandOk && daysOk;
   196	  const ts = (d: Date) => d.toLocaleString(undefined, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' }); const startD = f.start ? new Date(f.start) : new Date(); const endD = new Date(startD.getTime() + Number(f.days || 0) * 86400000);
   197	  const deploy = async () => { setOpen(false); setBusy(true); setOut('');
   198	    try { const w = await wallet(); const start = f.start ? BigInt(Math.floor(new Date(f.start).getTime() / 1000)) : 0n; const cap = BigInt(Math.round(Number(f.cap) * 100)) * 1000000n;
   199	      const h = await w.deployContract({ abi: ABI, bytecode: BYTECODE, args: [11035, 1035, 1105n, cap, BigInt(Math.round(Number(f.floor) * 1e8)), BigInt(Math.round(Number(f.band) * 100)), 100n, start, BigInt(f.days)], chain: w.chain, account: w.account! });
   200	      const r = await pub.waitForTransactionReceipt({ hash: h }); location.hash = '#/p/' + r.contractAddress; }
   201	    catch (e) { setOut(revertReason(e)); } setBusy(false); };
   202	  return <main className="create">
   203	    <section className="band"><div style={{ display: 'grid', gap: 8 }}><p className="addr">New agreement · HYPE on the HyperCore HYPE/USDC book</p><h1>Pledge your unlock</h1><p className="sub">Set the terms once. After signing nobody can loosen them, you included.</p></div></section>
   204	    <div className="grid">
   205	      <section className="card" aria-labelledby="h-terms">
   206	        <div className="card-h"><h2 id="h-terms">Terms</h2><span className="chip neutral">Fixed at deploy</span></div>
   207	        <div className="form-grid">
   208	          <label className="field">HYPE of filled size per 24 hours<input inputMode="decimal" value={f.cap} onChange={set('cap')} aria-invalid={!capOk} />{!capOk ? <span className="err">Above 0, at most 2 decimals.</span> : <span className="hint">The daily cap counts filled size only.</span>}</label>
   209	          <label className="field">Length in days<input inputMode="numeric" value={f.days} onChange={set('days')} aria-invalid={!daysOk} />{!daysOk ? <span className="err">A whole number, 1 to 3650.</span> : <span className="hint">The team can withdraw any remainder after this.</span>}</label>
   210	          <label className="field">Floor, USDC per HYPE<input inputMode="decimal" value={f.floor} onChange={set('floor')} aria-invalid={!floorOk} />{!floorOk ? <span className="err">Above 0, at most 8 decimals.</span> : <span className="hint">Sales halt below this price.</span>}</label>
   211	          <label className="field">Largest discount to the oracle, %<input inputMode="decimal" value={f.band} onChange={set('band')} aria-invalid={!bandOk} />{!bandOk ? <span className="err">Above 0 and under 100.</span> : <span className="hint">Sets the order limit under the oracle.</span>}</label>
   212	          <label className="field" style={{ gridColumn: '1/-1' }}>Selling begins<input type="datetime-local" value={f.start} onChange={set('start')} /><span className="hint">Leave blank to start now.</span></label>
   213	        </div>
   214	        {out && <p className="err" role="alert">{out}</p>}
   215	      </section>
   216	      <aside className="panel card" aria-label="Summary">
   217	        <div className="card-h"><h2>You are agreeing to</h2><span className="chip bad">Not cancelable</span></div>
   218	        <dl className="kv"><div><dt>Max sale / day</dt><dd>{f.cap} HYPE</dd></div><div><dt>Floor</dt><dd>${f.floor}</dd></div><div><dt>Max discount</dt><dd>{f.band}%</dd></div><div><dt>Term</dt><dd>{f.days} days</dd></div><div style={{ gridColumn: '1/-1' }}><dt>Selling starts</dt><dd>{ts(startD)}</dd></div><div style={{ gridColumn: '1/-1' }}><dt>Withdrawal opens</dt><dd>{ts(endD)}</dd></div></dl>
   219	        <Dialog open={open} onOpenChange={setOpen}>
   220	          <DialogTrigger asChild><button className="btn btn-primary wide" disabled={busy || !valid}>{busy ? 'Deploying' : 'Review and sign'}</button></DialogTrigger>
   221	          <DialogContent className="sign"><DialogHeader><DialogTitle>Sign this agreement</DialogTitle><DialogDescription>These terms cannot be changed after deployment.</DialogDescription></DialogHeader>
   222	            <ol className="sign-l"><li>Sell at most <b className="mono">{f.cap} HYPE</b> per day.</li><li>Never below <b className="mono">${f.floor}</b>, at most <b className="mono">{f.band}%</b> under the oracle.</li><li>Starts <b className="mono">{ts(startD)}</b>. No cancel, no withdrawal until <b className="mono">{ts(endD)}</b>.</li></ol>
   223	            <DialogFooter><DialogClose asChild><button className="btn btn-ghost">Go back</button></DialogClose><button className="btn btn-primary" onClick={deploy}>Sign and deploy on testnet</button></DialogFooter></DialogContent></Dialog>
   224	        {!valid && <p className="err">Fix the highlighted terms before signing.</p>}
   225	        <p className="muted" style={{ marginTop: 12 }}>Next: deposit HYPE from your HyperCore spot balance on the agreement page.</p>
   226	      </aside>
   227	    </div>
   228	  </main>;
