    64	.field{display:grid;gap:6px;font-size:14px;font-weight:600;color:var(--ink)}
    65	.field input{height:48px;border-radius:var(--radius-input);border:1px solid var(--line);background:var(--surface);padding:0 14px;font:500 16px var(--font-mono);color:var(--ink)}
