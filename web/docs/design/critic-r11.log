   117	              <div><p className="a-title">{t.label}</p><p className="meta">{t.rule}{t.tx && <> Already reverted on-chain in <a href={`${EXPLORER}/tx/${t.tx}`} target="_blank" rel="noreferrer" className="fig">{short(t.tx)}</a>.</>}</p></div>
   118	              <div className="a-act">{r ? <p className="verdict" role="status"><Badge variant={r.ok || !r.reverted ? 'outline' : 'destructive'}>{r.ok ? 'Allowed' : r.reverted ? 'Rejected by the contract' : 'Could not check (network)'}</Badge> <span className="fig">"{r.reason}"</span> <span className="meta fig">{r.at}</span></p> : <button className="btn-outline" onClick={() => run(t)} disabled={running === t.label} aria-busy={running === t.label}>{running === t.label ? 'Simulating' : t.btn}</button>}</div>
