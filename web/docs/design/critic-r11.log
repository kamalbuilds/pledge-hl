    80	  const sellSlice = () => act('Sale', async () => { const w = await wallet(); const h = await w.writeContract({ address: addr, abi: ABI, functionName: 'sell', args: [s.remaining < 50000000n ? s.remaining : 50000000n], gas: 400000n, chain: w.chain, account: w.account! }); const rc = await pub.waitForTransactionReceipt({ hash: h }); return `Sale ${rc.status === 'success' ? 'submitted' : 'reverted'}, tx ${short(h)}`; });
    81	  const reconcile = () => act('Reconcile', async () => { const w = await wallet(); const h = await w.writeContract({ address: addr, abi: ABI, functionName: 'reconcile', args: [], chain: w.chain, account: w.account! }); await pub.waitForTransactionReceipt({ hash: h }); return `Fills reconciled, tx ${short(h)}`; });
    82	  const deposit = () => act('Deposit', async () => { setDepOpen(false); const amt = depAmt; if (!depOk) throw new Error('enter an amount above 0 with at most 8 decimals');
