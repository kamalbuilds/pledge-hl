   124	            <Table className="ledger"><TableHeader><TableRow><TableHead>Time</TableHead><TableHead className="hide-sm">Side</TableHead><TableHead className="num hide-sm">Size</TableHead><TableHead className="num hide-sm">Price</TableHead><TableHead className="hide-sm">HyperCore hash</TableHead></TableRow></TableHeader>
   125	              <TableBody>{fills.map(f => <TableRow key={f.hash + f.time}><TableCell className="fig">{new Date(f.time).toLocaleString()}<span className="show-sm">{f.side === 'A' ? 'Sold' : 'Bought'} <span className="fig">{f.sz} HYPE @ {f.px}</span></span><span className="show-sm meta">Real fill, hash <a href={`https://app.hyperliquid-testnet.xyz/explorer/tx/${f.hash}`} target="_blank" rel="noreferrer">{short(f.hash)}</a></span></TableCell><TableCell className="hide-sm">{f.side === 'A' ? 'Sell' : 'Buy'} <Badge variant="outline">real</Badge></TableCell><TableCell className="num hide-sm">{f.sz}</TableCell><TableCell className="num hide-sm">{f.px}</TableCell><TableCell className="fig hide-sm">{short(f.hash)}</TableCell></TableRow>)}</TableBody></Table>}
