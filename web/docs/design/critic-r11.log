    85	  const used = s.remaining === 0n || s.balance === 0n; const depOk = /^\d+(\.\d{1,8})?$/.test(depAmt) && Number(depAmt) > 0 && Number(depAmt) <= 1e6;
    86	
    87	  return <main className="agreement">
    88	    <section className="top">
    89	      <div className="top-text">
    90	        <p className="ref">Agreement <a href={`${EXPLORER}/address/${addr}`} target="_blank" rel="noreferrer" className="fig">{short(addr)}</a> on HyperEVM testnet, signed by team <span className="fig">{short(s.team)}</span></p>
    91	        <h1>Lock agreement for {known ? +deposited.toFixed(4) : `at least ${+deposited.toFixed(4)}`} HYPE of unlocked supply</h1>
