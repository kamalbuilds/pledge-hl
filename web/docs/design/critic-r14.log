   198	      const cap = BigInt(Math.round(Number(f.cap) * 100)) * 1000000n;
   199	      const h = await w.deployContract({ abi: ABI, bytecode: BYTECODE, args: [11035, 1035, 1105n, cap, BigInt(Math.round(Number(f.floor) * 1e8)), BigInt(Math.round(Number(f.band) * 100)), 100n, start, BigInt(f.days)], chain: w.chain, account: w.account! });
   200	      const r = await pub.waitForTransactionReceipt({ hash: h }); location.hash = '#/p/' + r.contractAddress; }
   201	    catch (e) { setOut(revertReason(e)); } setBusy(false); };
   202	  return <main className="cols create"><article className="doc">
   203	    <p className="ref">Draft agreement for HYPE on the HyperCore HYPE/USDC spot book</p>
   204	    <h1>Draft a lock agreement</h1>
   205	    <p className="lede">Once signed, these terms are fixed in the contract. Nobody can loosen them, the team included.</p>
   206	    <ol className="clauses form">
   207	      <li><h2>Maximum sale per day</h2><label>HYPE of filled size per 24 hours<input inputMode="decimal" value={f.cap} onChange={set('cap')} aria-invalid={!capOk} /></label>{!capOk && <p className="bad">Use a number above 0 with at most 2 decimals.</p>}</li>
   208	      <li><h2>Start</h2><label>Selling begins (leave blank to start now)<input type="datetime-local" value={f.start} onChange={set('start')} /></label></li>
   209	      <li><h2>Term</h2><label>Length in days<input inputMode="numeric" value={f.days} onChange={set('days')} aria-invalid={!daysOk} /></label>{!daysOk && <p className="bad">A whole number of days, 1 to 3650.</p>}</li>
