.fig1 svg{width:100%;height:auto;display:block}
.fig1 .grid{stroke:var(--rule);stroke-width:1}.fig1 .ax{font:400 var(--t1) var(--mono);fill:var(--slate)}
.fig1 .allow{fill:none;stroke:var(--amber);stroke-width:3.5}.fig1 .ghostl{fill:var(--amber-text);font-style:italic}.fig1 .sold{fill:none;stroke:var(--navy);stroke-width:2.5}
.fig1 .dep{stroke:var(--amber);stroke-dasharray:5 4;stroke-width:1}.fig1 .depl{fill:var(--amber-text)}.fig1 .ghost{fill:none;stroke:var(--amber);stroke-width:1.5;stroke-dasharray:4 4}
.fig1 .now{stroke:var(--slate);stroke-dasharray:2 3}.fig1 .dot{fill:var(--navy);stroke:var(--bone);stroke-width:2}.fig1 .dotl{fill:var(--navy);font-weight:500}
.fig1-table tr.future td{color:var(--slate)}
.fig1 figcaption{font-size:var(--t1);color:var(--slate);display:flex;flex-wrap:wrap;gap:4px 16px;align-items:center;margin-top:8px}
.k{display:inline-block;width:16px;height:3px;margin-right:8px;vertical-align:middle}.allowk{background:var(--amber)}.ghostk{background:repeating-linear-gradient(90deg,var(--amber) 0 3px,transparent 3px 7px)}.lg{white-space:nowrap;display:inline-flex;align-items:center}.src{flex-basis:100%}.soldk{background:var(--navy)}.dotk{width:9px;height:9px;border-radius:50%;background:var(--navy)}

.cols{display:grid;grid-template-columns:minmax(0,1fr) 380px;gap:56px;padding:12px 0 32px}
.doc{max-width:700px;min-width:0}
.clauses{list-style:none;counter-reset:c;padding:0;margin:0}
.clauses>li{counter-increment:c;position:relative;padding:24px 0 24px 48px;border-bottom:1px solid var(--rule);scroll-margin-top:16px}
.clauses>li::before{content:counter(c) ".";position:absolute;left:0;top:24px;font:400 var(--t4)/1 var(--serif);color:var(--navy)}
.clauses h2{font:500 var(--t3)/1.3 var(--serif);margin-bottom:8px}
.clauses p{margin:0 0 12px;max-width:62ch}
.terms{max-width:460px}.terms th{font-weight:400;color:var(--slate);text-align:left}
table th,table td{font-size:var(--t1)}
.fig1-table th{font:600 var(--t1) var(--sans);color:var(--slate)}.ledger th{font-weight:600;color:var(--slate)}

.attempts{border-top:1px solid var(--rule);margin-top:8px}
.attempt{display:grid;grid-template-columns:1fr 250px;gap:20px;padding:12px 0;border-bottom:1px solid var(--rule);align-items:center}
.a-title{font-weight:600}.a-act{text-align:right}.verdict{font-size:var(--t1);display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;align-items:center}

.btn-primary,.btn-outline,.btn-text{font:600 var(--t2) var(--sans);cursor:pointer;border-radius:var(--r);transition:background-color .15s ease-out,color .15s ease-out,border-color .15s ease-out}
.btn-primary{background:var(--navy);color:var(--bone);border:1px solid var(--navy);padding:12px 16px}
.btn-primary:hover:not(:disabled){background:var(--ink);border-color:var(--ink)}
.btn-outline{background:transparent;color:var(--navy);border:1px solid var(--navy);padding:8px 16px;font-size:var(--t1)}
.btn-outline:hover:not(:disabled){background:var(--navy);color:var(--bone)}
.btn-text{background:none;border:0;padding:4px 0;color:var(--navy);text-decoration:underline;text-underline-offset:3px;font-size:var(--t1)}
button:disabled{opacity:.5;cursor:default}.wide{width:100%}

.rail{position:sticky;top:16px;align-self:start;border-left:1px solid var(--ink);padding:20px 0 0 28px;display:grid;gap:16px}
.rail-h{font:500 var(--t3) var(--serif)}.rail-h3{font:600 var(--t1) var(--sans);color:var(--ink)}
.attrs{display:grid;grid-template-columns:1fr 1fr;margin:0;border-top:1px solid var(--rule)}
.attrs div{padding:12px 0;border-bottom:1px solid var(--rule)}.attrs div:nth-child(odd){padding-right:12px}
.attrs dt{font-size:var(--t1);color:var(--slate)}.attrs dd{margin:2px 0 0;font-size:var(--t2);color:var(--ink)}.lock{color:var(--amber-text)!important}
.tl{list-style:none;margin:0;padding:0}
.tl li{display:grid;grid-template-columns:16px 1fr;gap:12px;position:relative;padding-bottom:12px}
.tl li:not(:last-child)::after{content:"";position:absolute;left:5px;top:16px;bottom:0;width:1px;background:var(--rule)}
.tl-dot{width:11px;height:11px;border:1.5px solid var(--navy);border-radius:50%;margin-top:5px;background:var(--bone)}
.tl li.done .tl-dot{background:var(--navy)}.tl p{font-size:var(--t2)}.tl .meta{font-size:var(--t1)}
.rail-act{display:grid;gap:8px;padding-top:4px;border-top:1px solid var(--rule)}.rail-act .meta{padding-top:8px}
.toc{border-top:1px solid var(--rule);padding-top:12px}.toc ol{list-style:none;padding:0;margin:4px 0 0;display:grid;gap:2px}.toc a{font-size:var(--t1);text-decoration:none}.toc a:hover{text-decoration:underline}
.log{list-style:none;padding:0;margin:4px 0 0;font-size:var(--t1)}

.annex{margin:16px 0 12px;border:1px solid var(--rule);border-radius:var(--r);padding:12px 16px}.annex summary{cursor:pointer;font-weight:600;font-size:var(--t1)}

.create{padding-top:40px}.create h1{margin:4px 0 12px}
.form label{display:flex;flex-direction:column;gap:8px;font-size:var(--t1);color:var(--slate);margin:8px 0;max-width:360px}
.form input{font:400 var(--t3) var(--mono);color:var(--ink);background:transparent;border:0;border-bottom:1px solid var(--ink);border-radius:var(--r);padding:8px 0}
.form input:focus-visible{outline:none;border-bottom:2px solid var(--navy)}
.sign{background:var(--bone);border:1px solid var(--ink);border-radius:var(--r)}.sign-t{font:500 var(--t4) var(--serif)}.sign-d{color:var(--slate)}.sign-l{padding-left:20px;display:grid;gap:4px}
.doc-solo{padding:48px 0;display:grid;gap:12px;justify-items:start}

.foot{border-top:1px solid var(--ink);padding:16px 0 40px;font-size:var(--t1);color:var(--slate)}.foot p{max-width:80ch}

@media (max-width:960px){.jumps{display:flex}.fig1-tw summary{display:block;cursor:pointer;font-size:var(--t1);font-weight:600;min-height:44px;line-height:44px}.btn-outline,.btn-primary,.mast-link,.btn-text,.annex summary,.toc a{min-height:44px;display:inline-flex;align-items:center;justify-content:center}.top-text .lede{grid-column:auto;grid-row:auto}.cols,.top-text,.fig1-body{grid-template-columns:minmax(0,1fr);gap:28px}.rail{position:static;border-left:0;border-top:1px solid var(--ink);padding:16px 0 0}.toc{display:none}.mast{grid-template-columns:1fr auto}.mast-note{display:none}}
@media (max-width:480px){.top-text .lede{display:none}.top{padding-top:24px;gap:16px}.top-text{gap:8px}.hide-sm{display:none}.show-sm{display:block}.fig1-body{gap:16px}.btn-outline,.btn-primary,.mast-link,.btn-text{min-height:44px;display:inline-flex;align-items:center;justify-content:center}.lg{white-space:normal}.page{padding:0 16px}h1{font-size:var(--t4)}.lede{font-size:var(--t2)}.clauses>li{padding-left:34px}.clauses>li::before{font-size:var(--t3)}.attempt{grid-template-columns:1fr}.a-act{text-align:left}.verdict{justify-content:flex-start}.ledger{display:block;overflow-x:auto}.attrs{grid-template-columns:1fr 1fr}}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
