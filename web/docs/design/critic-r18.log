   141	            <><ul className="fill-list show-sm" aria-label="Sales">{fills.map(f => <li key={f.hash + f.time}><div style={{ display: 'flex', alignItems: 'center', gap: 8 }}><span className={'chip ' + (f.side === 'A' ? 'ok' : 'neutral')}>{f.side === 'A' ? 'Sell' : 'Buy'}</span><b className="mono">{f.sz} HYPE</b><span className="muted">@ {f.px} USDC</span></div><div className="muted mono">{new Date(f.time).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })} · <a className="link" href={`https://app.hyperliquid-testnet.xyz/explorer/tx/${f.hash}`} target="_blank" rel="noreferrer">{short(f.hash)}</a></div></li>)}</ul><Table className="dtable ledger hide-sm"><TableHeader><TableRow><TableHead>Time</TableHead><TableHead className="hide-sm">Side</TableHead><TableHead className="num">Size HYPE</TableHead><TableHead className="num">Price USDC</TableHead><TableHead className="hide-sm">Hash</TableHead></TableRow></TableHeader>
   142	              <TableBody>{fills.map(f => <TableRow key={f.hash + f.time}><TableCell className="mono">{new Date(f.time).toLocaleString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}</TableCell><TableCell className="hide-sm"><span className={'chip ' + (f.side === 'A' ? 'ok' : 'neutral')}>{f.side === 'A' ? 'Sell' : 'Buy'}</span></TableCell><TableCell className="num">{f.sz}</TableCell><TableCell className="num">{f.px}</TableCell><TableCell className="hide-sm"><a className="link mono" href={`https://app.hyperliquid-testnet.xyz/explorer/tx/${f.hash}`} target="_blank" rel="noreferrer">{short(f.hash)}</a></TableCell></TableRow>)}</TableBody></Table></>}
   143	          <details className="more" style={{ marginTop: 12 }}><summary>Fork-simulated checks <span className="chip warn" style={{ marginLeft: 8 }}>fork-simulated</span></summary>
   144	            <p className="muted">{forkSim.note}</p>
   145	            <Table className="dtable"><TableBody>{forkSim.runs.map((x: any) => <TableRow key={x.name}><TableCell>{x.name}</TableCell><TableCell className="muted hide-sm">{x.detail}</TableCell><TableCell className="num"><span className={'chip ' + (x.pass ? 'ok' : 'bad')}>{x.pass ? 'Pass' : 'Fail'}</span></TableCell></TableRow>)}</TableBody></Table></details>
   146	        </section>
   147	
   148	        <section className="card" id="c3" aria-labelledby="h-price">
   149	          <div className="card-h"><h2 id="h-price">Price guard</h2>{halted ? <span className="chip bad">Fails: sales halt</span> : <span className="chip ok">Passes</span>}</div>
   150	          <p>Each sale is an immediate-or-cancel order priced by the contract, never by the caller: the oracle less {Number(s.dev) / 100}%, and never below the floor.</p>
   151	          <div className="stat3"><div><b>${fmt8(s.oracle, 3)}</b><span>Oracle (0x808)</span></div><div><b>${fmt8(s.limit, 3)}</b><span>Order limit</span></div><div><b>${fmt8(s.floor, 2)}</b><span>Floor</span></div></div>
   152	        </section>
   153	
   154	        <section className="card" id="c4" aria-labelledby="h-break">
   155	          <div className="card-h"><h2 id="h-break">Try to break it</h2><span className="chip neutral">Live, read-only</span></div>
   156	          <p className="muted" style={{ marginBottom: 12 }}>Each check simulates the call against the live contract. No wallet, no gas.</p>
   157	          <div className="checks">{TRIES.map(t => { const r = tries[t.label]; return <div className="check" key={t.label}>
   158	            <div><p className="t">{t.label}</p><p className="r">{t.rule}{t.tx && <> Already reverted on-chain: <Addr a={t.tx} kind="tx" />.</>}</p></div>
   159	            {r ? <div className="verdict" role="status"><span className={'chip ' + (r.ok ? 'warn' : r.reverted ? 'bad' : 'neutral')}>{r.ok ? 'Allowed' : r.reverted ? 'Rejected by the contract' : 'Could not check (network)'}</span><span className="mono">"{r.reason}" · {r.at}</span>{!r.ok && !r.reverted && <button className="btn btn-secondary" onClick={() => run(t)} disabled={running === t.label}>Retry check</button>}</div>
   160	              : <button className="btn btn-secondary" onClick={() => run(t)} disabled={running === t.label} aria-busy={running === t.label}>{running === t.label ? 'Simulating' : t.btn}</button>}
   161	          </div>; })}</div>
   162	        </section>
   163	
   164	        <section className="card" id="c5" aria-labelledby="h-term">
   165	          <div className="card-h"><h2 id="h-term">Term</h2><span className="chip neutral">Ends in <Countdown to={Number(s.end)} /></span></div>
   166	          <div className="kv" style={{ margin: 0 }}><div><dt>Selling began</dt><dd>{dt(Number(s.start))}</dd></div><div><dt>Team may withdraw from</dt><dd>{dt(Number(s.end))}</dd></div></div>
   167	          {isDemo && <p className="muted" style={{ marginTop: 12 }}>Created in tx <Addr a={DEMO_DEPLOY_TX} kind="tx" />.</p>}
   168	        </section>
   169	              </div>
   170	
   171	    </div>
   172	  </main>;
   173	}
   174	
   175	const E2E = { pledge: '0x9af101c5d73432510e037dc8b05ec35811de91a5', create: '0x1327f21141d54cbb8667c1c7ede7a28b494f48c602eee9e36bdb254a45fa3d57', sale: '0x5f9fb781be281ef3fe5acfb59c05ca45803314ba46ece30e117bb2f7fe051913', reconcile: '0x48b4ea63b122be32ab223c9f05b40936649ca0877f93b2e7a9549cbb59c65bd7' };
   176	function Judges({ addr }: { addr: Address }) {
   177	  const [copied, setCopied] = useState<'' | 'ok' | 'fail'>('');
   178	  const curl = `curl -s -X POST https://api.hyperliquid-testnet.xyz/info -H 'content-type: application/json' -d '{"type":"userFills","user":"${addr}"}'`;
   179	  const RV: [string, string, string][] = [
   180	    ['ok', 'Real, testnet', 'Create, deposit, IOC sale filled on HyperCore, filled-size daily cap, unfilled order refund'],
   181	    ['ok', 'Real, testnet', 'Cancel and early withdraw revert; sale blocked under the floor and before the start; team release after the end; anyone can trigger a sale'],
   182	    ['warn', 'Fork-simulated', 'Daily allowance resetting across several days, price crash mid-term'],
   183	    ['neutral', 'Planned', '0.25% fee, mainnet, other tokens'],
   184	  ];
   185	  return <>
   186	    <section className="band" style={{ marginBottom: 24 }}><div style={{ display: 'grid', gap: 8 }}><p className="addr">Hyperliquid testnet evidence</p><h1>Verify PLEDGE on-chain</h1><p className="sub">Four checks against the live demo agreement, plus what is real and what is simulated.</p></div></section>
   187	    <section className="card" id="judges" aria-labelledby="h-j">
   188	      <div className="card-h"><h2 id="h-j">For judges: verify on-chain</h2><span className="chip ok">About 60 seconds</span></div>
   189	      <ol className="steps">
   190	        <li><p><b>The contract holds the terms.</b> Open <Addr a={addr} /> on the testnet explorer. No owner, no admin, no early withdraw. Source: contracts/src/Pledge.sol in the repo.</p></li>
   191	        <li><p><b>It cannot be cancelled.</b> Press the three buttons in "Try to break it" on the <a className="link" href="#/">agreement page</a>. While the term runs, each one is rejected by the contract.</p></li>
   192	        <li><div><p><b>Check the fills yourself.</b> Look for side "A" (sell). A new agreement returns an empty list.</p><pre className="code">{curl}</pre>
   193	          <button className="btn btn-secondary" onClick={() => (navigator.clipboard ? navigator.clipboard.writeText(curl) : Promise.reject()).then(() => setCopied('ok'), () => setCopied('fail'))}>{copied === 'ok' ? 'Copied' : 'Copy command'}</button>{copied === 'fail' && <p className="err">The browser blocked copying. Select the command and copy it by hand.</p>}</div></li>
   194	        <li><p><b>The full wallet flow ran on testnet.</b> Separate test agreement <Addr a={E2E.pledge} />: create <Addr a={E2E.create} kind="tx" />, sale <Addr a={E2E.sale} kind="tx" /> (0.5 HYPE @ 22.538), reconcile <Addr a={E2E.reconcile} kind="tx" />.</p></li>
   195	      </ol>
   196	      <div className="rv">{RV.map(([c, l, t]) => <div key={t}><span className={'chip ' + c}>{l}</span><span>{t}</span></div>)}</div>
   197	    </section>
   198	  </>;
   199	}
   200	
   201	function Business() {
   202	  return <>
   203	    <section className="band" style={{ marginBottom: 24 }}><div style={{ display: 'grid', gap: 8 }}><p className="addr">Who pays and how big</p><h1>Business model</h1><p className="sub">The token team pays a planned fee on filled sales. Market figures are sourced.</p></div></section>
   204	    <section className="card" id="business" aria-labelledby="h-b">
   205	      <div className="card-h"><h2 id="h-b">Business model</h2><span className="chip neutral">Fee planned</span></div>
   206	      <div className="stat3"><div><b>$97.43B</b><span>Tokens unlocked in 2025</span></div><div><b>$18.77B</b><span>Of that to insiders</span></div><div><b>0.25%</b><span>Planned fee on filled proceeds</span></div></div>
   207	      <p><b>The token team pays</b>, only when a sale fills. Buyers and keepers pay no PLEDGE fee, only gas. For comparison, Streamflow charges 0.16 SOL plus 0.19% of tokens vested (0.5% for a lock); Sablier charges $0.99 per withdrawal. Illustration only: 1% of insider unlocks at 0.25% is about $470K a year; this is the global market, not proof of demand on Hyperliquid. The fee is not in the testnet contract.</p>
   208	      <p className="muted" style={{ marginTop: 12 }}>Sources: <a className="link" href="https://www.tokenomist.ai/research/2025-token-unlocks-review-a-complete-breakdown-of-emissions-insider-vesting-and-market-impact" target="_blank" rel="noreferrer">Tokenomist</a> · <a className="link" href="https://streamflow.finance/blog/how-much-does-streamflow-cost" target="_blank" rel="noreferrer">Streamflow</a> · <a className="link" href="https://docs.sablier.com/concepts/fees" target="_blank" rel="noreferrer">Sablier</a></p>
   209	    </section>
   210	  </>;
   211	}
   212	
   213	function Create() {
   214	  const [f, setF] = useState({ cap: '0.5', floor: '5', start: '', days: '30', band: '2' }); const [out, setOut] = useState(''); const [busy, setBusy] = useState(false); const [open, setOpen] = useState(false);
   215	  const set = (k: string) => (e: any) => setF({ ...f, [k]: e.target.value }); const capOk = /^\d+(\.\d{1,2})?$/.test(f.cap) && Number(f.cap) > 0 && Number(f.cap) <= 1e6, floorOk = /^\d+(\.\d{1,8})?$/.test(f.floor) && Number(f.floor) > 0 && Number(f.floor) <= 1e9, bandOk = /^\d+(\.\d{1,2})?$/.test(f.band) && Number(f.band) > 0 && Number(f.band) < 100, daysOk = /^\d+$/.test(f.days) && Number(f.days) >= 1 && Number(f.days) <= 3650, valid = capOk && floorOk && bandOk && daysOk;
   216	  const ts = (d: Date) => d.toLocaleString(undefined, { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZoneName: 'short' }); const startD = f.start ? new Date(f.start) : new Date(); const endD = new Date(startD.getTime() + Number(f.days || 0) * 86400000);
   217	  const [mid, setMid] = useState(0); const [tx, setTx] = useState<Tx>({ phase: 'idle' });
   218	  useEffect(() => { fetch('https://api.hyperliquid-testnet.xyz/info', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ type: 'allMids' }) }).then(r => r.json()).then(m => setMid(Number(m['@1035'] || m.HYPE || 0))).catch(() => {}); }, []);
   219	  const deploy = async () => { setOpen(false); setBusy(true); setOut(''); setTx({ phase: 'wallet' });
   220	    try { const w = await wallet(); const start = f.start ? BigInt(Math.floor(new Date(f.start).getTime() / 1000)) : 0n; const cap = BigInt(Math.round(Number(f.cap) * 100)) * 1000000n;
   221	      const h = await w.deployContract({ abi: ABI, bytecode: BYTECODE, args: [11035, 1035, 1105n, cap, BigInt(Math.round(Number(f.floor) * 1e8)), BigInt(Math.round(Number(f.band) * 100)), 100n, start, BigInt(f.days)], chain: w.chain, account: w.account! }); setTx({ phase: 'pending', hash: h });
   222	      const r = await pub.waitForTransactionReceipt({ hash: h }); setTx({ phase: 'confirmed', hash: h, msg: 'Opening the agreement' }); location.hash = '#/p/' + r.contractAddress; }
   223	    catch (e) { setOut(revertReason(e)); setTx({ phase: 'failed', msg: 'Nothing was deployed' }); } setBusy(false); };
   224	  return <main className="create">
   225	    <section className="band"><div style={{ display: 'grid', gap: 8 }}><p className="addr">New agreement · HYPE on the HyperCore HYPE/USDC book</p><h1>Pledge your unlock</h1><p className="sub">Set the terms once. After signing nobody can loosen them, you included.</p></div></section>
   226	    <div className="grid">
   227	      <section className="card" aria-labelledby="h-terms">
   228	        <div className="card-h"><h2 id="h-terms">Terms</h2><span className="chip neutral">Fixed at deploy</span></div>
   229	        <div className="form-grid">
   230	          <label className="field">HYPE of filled size per 24 hours<input inputMode="decimal" value={f.cap} onChange={set('cap')} aria-invalid={!capOk} />{!capOk ? <span className="err">Above 0, at most 2 decimals.</span> : <span className="hint">The daily cap counts filled size only.</span>}</label>
   231	          <label className="field">Length in days<input inputMode="numeric" value={f.days} onChange={set('days')} aria-invalid={!daysOk} />{!daysOk ? <span className="err">A whole number, 1 to 3650.</span> : <span className="hint">The team can withdraw any remainder after this.</span>}</label>
   232	          <label className="field">Floor, USDC per HYPE<input inputMode="decimal" value={f.floor} onChange={set('floor')} aria-invalid={!floorOk} />{!floorOk ? <span className="err">Above 0, at most 8 decimals.</span> : <span className="hint">Sales halt below this price.</span>}</label>
   233	          <label className="field">Largest discount to the oracle, %<input inputMode="decimal" value={f.band} onChange={set('band')} aria-invalid={!bandOk} />{!bandOk ? <span className="err">Above 0 and under 100.</span> : <span className="hint">Sets the order limit under the oracle.</span>}</label>
   234	          <label className="field" style={{ gridColumn: '1/-1' }}>Selling begins<input type="datetime-local" value={f.start} onChange={set('start')} /><span className="hint">Leave blank to start now.</span></label>
   235	        </div>
   236	        {out && <p className="err" role="alert">{out}</p>}
   237	      </section>
   238	      <aside className="panel card" aria-label="Summary">
   239	        <div className="card-h"><h2>You are agreeing to</h2><span className="chip neutral">Not cancelable</span></div>
   240	        <dl className="kv"><div><dt>Max sale / day</dt><dd>{f.cap} HYPE</dd></div><div><dt>Floor</dt><dd>${f.floor}</dd></div><div><dt>Max discount</dt><dd>{f.band}%</dd></div><div><dt>Term</dt><dd>{f.days} days</dd></div><div style={{ gridColumn: '1/-1' }}><dt>Selling starts</dt><dd>{ts(startD)}</dd></div><div style={{ gridColumn: '1/-1' }}><dt>Withdrawal opens</dt><dd>{ts(endD)}</dd></div></dl>
   241	        <Dialog open={open} onOpenChange={setOpen}>
   242	          <DialogTrigger asChild><button className="btn btn-primary wide" disabled={busy || !valid}>{busy ? 'Deploying' : 'Review and sign'}</button></DialogTrigger>
   243	          <DialogContent className="sign"><DialogHeader><DialogTitle>Sign this agreement</DialogTitle><DialogDescription>These terms cannot be changed after deployment.</DialogDescription></DialogHeader>
   244	            <div className="outcome"><p className="t">Simulated outcome at today's oracle (~{usd(mid)} / HYPE)</p><ul><li>Each day at most <b className="mono">{f.cap} HYPE</b> sells, about <b className="mono">{usd(Number(f.cap) * mid)}</b>.</li><li>Over {f.days} days that is at most <b className="mono">{+(Number(f.cap) * Number(f.days)).toFixed(2)} HYPE</b>; any remainder returns to you after the end.</li><li>{mid && Number(f.floor) > mid ? <span className="err">Your floor is above today's price, so nothing would sell right now.</span> : <>Sales halt if the price drops under ${f.floor}.</>}</li></ul></div>
   245	            <ol className="sign-l"><li>Sell at most <b className="mono">{f.cap} HYPE</b> per day.</li><li>Never below <b className="mono">${f.floor}</b>, at most <b className="mono">{f.band}%</b> under the oracle.</li><li>Starts <b className="mono">{ts(startD)}</b>. No cancel, no withdrawal until <b className="mono">{ts(endD)}</b>.</li></ol>
   246	            <DialogFooter><DialogClose asChild><button className="btn btn-ghost">Go back</button></DialogClose><button className="btn btn-primary" onClick={deploy}>Sign and deploy on testnet</button></DialogFooter></DialogContent></Dialog>
   247	        <TxState t={tx} />
   248	        {!valid && <p className="err">Fix the highlighted terms before signing.</p>}
   249	        <p className="muted" style={{ marginTop: 12 }}>Next: deposit HYPE from your HyperCore spot balance on the agreement page.</p>
   250	      </aside>
   251	    </div>
   252	  </main>;
   253	}

