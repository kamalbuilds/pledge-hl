 b=re.search(r'"'```text'"\\n(.*?)\\n"'```'"',t,re.S).group(1).splitlines()
 expected=['hierarchy','layout/space use','typography','colour/contrast','distinctiveness (not AI-generic)','fidelity to the v4 wise product direction','data/chart clarity','mobile']
